# FullText Search — 环境变量配置
# 复制此文件为 .env 并修改配置：
#   cp .env.example .env

# 资料目录（宿主机路径，指向你的文档文件夹）
# 默认: ./data/docs（项目目录下的 data/docs）
DATA_DIR=./data/docs

# 额外资料目录（多个用逗号分隔）
# 会被挂载到 /data/名称 下，自动注册到索引
# 例如: EXTRA_DIRS=/mnt/nas/合同,/mnt/nas/图纸
EXTRA_DIRS=

# Web 访问端口
PORT=8080

# OCR 语言：ch / en / japan / korean
OCR_LANG=ch

# OCR 并发数（PaddleOCR 每线程约 300-500MB 内存）
# 可用内存 >6G 建议 3，3-6G 建议 2，<3G 建议 1
OCR_CONCURRENT=2

# 每日定时扫描时间（24小时制）
SCHEDULED_SCAN_TIME=00:00

# 构建时跳过（已有镜像时设为 1）
SKIP_BUILD=0

# Docker 镜像站（无法访问 Docker Hub 时使用）
# 例如: REGISTRY=mirror.example.com/library/
REGISTRY=
